build_linux_kernel_6_8
<- concept_software_build;
<- concept_wit_entity;
=> nrel_main_idtf:
    [сборка ядра Linux 6.8]
    (* <- lang_ru;; *);
    [Linux kernel 6.8 build]
    (* <- lang_en;; *);
=> nrel_note:
    [Результат компиляции и компоновки ядра с поддержкой целевых архитектур: подписанный
     загрузочный образ и пакеты для дистрибутивов.]
    (* <- lang_ru;; *);
    [The result of compiling and linking the kernel with support for the target
     architectures: a signed boot image and packages for distributions.]
    (* <- lang_en;; *);
=> nrel_build_testing: testing_linux_kernel_selftests;;

