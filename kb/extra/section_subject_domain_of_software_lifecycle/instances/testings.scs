testing_linux_kernel_selftests
<- concept_software_testing;
<- concept_wit_entity;
=> nrel_main_idtf:
    [самотестирование ядра Linux 6.8]
    (* <- lang_ru;; *);
    [Linux kernel 6.8 self-testing]
    (* <- lang_en;; *);
=> nrel_note:
    [Комплекс функциональных и нагрузочных тестов, проверяющих планировщик, управление
     памятью и драйверы собранного ядра.]
    (* <- lang_ru;; *);
    [A set of functional and load tests checking the scheduler, memory management and the
     drivers of the built kernel.]
    (* <- lang_en;; *);
=> nrel_testing_release: release_linux_kernel_6_8;;

testing_postgresql_regression
<- concept_software_testing;
<- concept_wit_entity;
=> nrel_main_idtf:
    [регрессионное тестирование PostgreSQL 16.2]
    (* <- lang_ru;; *);
    [PostgreSQL 16.2 regression testing]
    (* <- lang_en;; *);
=> nrel_note:
    [Запуск штатного набора регрессионных тестов и отдельная проверка времени обслуживания
     на данных объёмом два миллиарда строк.]
    (* <- lang_ru;; *);
    [Running the standard regression test suite and a separate check of the maintenance time
     on data of two billion rows.]
    (* <- lang_en;; *);
=> nrel_testing_release: release_postgresql_16_2;;

