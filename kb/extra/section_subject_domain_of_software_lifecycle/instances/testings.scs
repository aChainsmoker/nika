testing_skyway_booking_e2e
<- concept_software_testing;
<- concept_wit_entity;
=> nrel_main_idtf:
    [сквозное тестирование бронирования «Скайвей» 1.0]
    (* <- lang_ru;; *);
    [Skyway 1.0 end-to-end booking testing]
    (* <- lang_en;; *);
=> nrel_note:
    [Проверка полного сценария поиска, выбора тарифа, удержания и оплаты места, включая
     контроль отсутствия двойных броней под нагрузкой и совпадения стоимости на всех этапах.]
    (* <- lang_ru;; *);
    [Verification of the full search, fare selection, seat hold and payment scenario,
     including the control of the absence of double bookings under load and of the fare
     consistency at all stages.]
    (* <- lang_en;; *);
=> nrel_testing_release: release_skyway_booking_1_0;;
