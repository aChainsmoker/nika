design_linux_scheduler
<- concept_software_design;
<- concept_wit_entity;
=> nrel_main_idtf:
    [проектное решение по планировщику задач ядра Linux]
    (* <- lang_ru;; *);
    [design of the Linux kernel task scheduler]
    (* <- lang_en;; *);
=> nrel_note:
    [Проектное описание, определяющее выбор алгоритма планирования, поведение очередей
     готовности и условия переноса задач между группами процессоров.]
    (* <- lang_ru;; *);
    [A design description that determines the choice of the scheduling algorithm, the
     behaviour of run queues and the conditions for migrating tasks between processor
     groups.]
    (* <- lang_en;; *);
=> nrel_design_architecture: architecture_linux_scheduler;;

design_postgresql_vacuum
