release_linux_kernel_6_8
<- concept_software_release;
<- concept_wit_entity;
=> nrel_main_idtf:
    [выпуск ядра Linux 6.8]
    (* <- lang_ru;; *);
    [Linux kernel 6.8 release]
    (* <- lang_en;; *);
=> nrel_note:
    [Зафиксированный релиз с составом прошедших самотестирование изменений подсистемы
     планирования и подписью мейнтейнеров проекта.]
    (* <- lang_ru;; *);
    [A recorded release containing the scheduling subsystem changes that passed self-testing
     and signed by the project maintainers.]
    (* <- lang_en;; *);
=> nrel_release_deployment: deployment_linux_kernel_6_8;;

