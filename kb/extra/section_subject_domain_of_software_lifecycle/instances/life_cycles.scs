    testing_postgresql_regression;
    release_postgresql_16_2;
    deployment_postgresql_16_2_cluster;
    operation_postgresql_16_2_production;
    maintenance_postgresql_16_branch;;

life_cycle_git
<- concept_software_life_cycle;
<- concept_wit_entity;
=> nrel_main_idtf:
    [жизненный цикл Git]
    (* <- lang_ru;; *);
    [Git life cycle]
    (* <- lang_en;; *);
=> nrel_note:
    [Жизненный цикл системы контроля версий, в рамках которого начиная со сборки и
     последующих выпусков исправляются дефекты производительности при слиянии в крупных
     репозиториях.]
    (* <- lang_ru;; *);
    [The life cycle of a version control system in which, starting from the build and the
     subsequent releases, the performance defects of merging in large repositories are
     corrected.]
    (* <- lang_en;; *);
=> nrel_life_cycle_software: software_git;
=> nrel_life_cycle_stage:
    planning_git_merge_performance;
    build_git_2_45;
    testing_git_ci;
    release_git_2_45;
    deployment_git_hosting;
    operation_git_hosting;
    maintenance_git_2_45_x;;

life_cycle_skyway_booking
