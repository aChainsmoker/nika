life_cycle_linux_kernel
<- concept_software_life_cycle;
<- concept_wit_entity;
=> nrel_main_idtf:
    [жизненный цикл ядра Linux]
    (* <- lang_ru;; *);
    [Linux kernel life cycle]
    (* <- lang_en;; *);
=> nrel_note:
    [Совокупность стадий, через которые проходит ядро Linux: от уточнения требований к
     подсистеме планирования до завершения её сопровождения в ветке длительной поддержки.]
    (* <- lang_ru;; *);
    [The set of stages the Linux kernel passes through: from clarifying the requirements for
     the scheduling subsystem to the completion of its maintenance in the long-term
     support branch.]
    (* <- lang_en;; *);
=> nrel_life_cycle_software: software_linux_kernel;
=> nrel_life_cycle_stage:
    planning_linux_scheduler_subsystem;
    requirements_gathering_linux_scheduler_latency;
    requirement_linux_scheduler_latency;
    design_linux_scheduler;
    architecture_linux_scheduler;
    implementation_linux_scheduler;
    build_linux_kernel_6_8;
    testing_linux_kernel_selftests;
    release_linux_kernel_6_8;
    deployment_linux_kernel_6_8;
    operation_linux_kernel_6_8;
    maintenance_linux_kernel_6_8_lts;;

