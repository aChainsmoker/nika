software_skyway_booking
<- concept_software;
<- concept_wit_entity;
=> nrel_main_idtf:
    [система бронирования «Скайвей»]
    (* <- lang_ru;; *);
    [Skyway booking system]
    (* <- lang_en;; *);
=> nrel_note:
    [Вымышленная платформа бронирования авиабилетов, обеспечивающая поиск рейсов, выбор
     тарифа, удержание места в резерве и приём оплаты.]
    (* <- lang_ru;; *);
    [A fictional flight booking platform providing flight search, fare selection, seat
     reservation hold and payment acceptance.]
    (* <- lang_en;; *);
=> nrel_software_problem:
    problem_skyway_double_booking;
    problem_skyway_price_mismatch;
=> nrel_software_stakeholder:
    stakeholder_skyway_product_owner;
    stakeholder_skyway_customers;
    stakeholder_skyway_operations_team;
=> nrel_software_requirement:
    requirement_skyway_seat_locking;
    requirement_skyway_price_consistency;
=> nrel_software_planning:
    planning_skyway_booking_launch;
=> nrel_software_quality:
    quality_performance;
    quality_security;
    quality_availability;;
