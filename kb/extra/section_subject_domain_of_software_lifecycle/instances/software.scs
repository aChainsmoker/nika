software_linux_kernel
<- concept_software;
<- concept_wit_entity;
=> nrel_main_idtf:
    [ядро Linux]
    (* <- lang_ru;; *);
    [Linux kernel]
    (* <- lang_en;; *);
=> nrel_note:
    [Операционная система общего назначения и основа Linux-систем, исходный код которого
     разрабатывается и сопровождается большим сообществом разработчиков.]
    (* <- lang_ru;; *);
    [A general-purpose operating system and the basis of Linux systems, whose source code
     is developed and maintained by a large community of developers.]
    (* <- lang_en;; *);
=> nrel_software_problem: problem_linux_scheduler_latency;
=> nrel_software_stakeholder: stakeholder_linux_foundation;
=> nrel_software_requirement: requirement_linux_scheduler_latency;
=> nrel_software_planning: planning_linux_scheduler_subsystem;
=> nrel_software_quality:
    quality_reliability;
    quality_performance;
    quality_maintainability;;

software_postgresql
<- concept_software;
<- concept_wit_entity;
=> nrel_main_idtf:
    [PostgreSQL]
    (* <- lang_ru;; *);
    [PostgreSQL]
    (* <- lang_en;; *);
=> nrel_note:
    [Свободная объектно-реляционная система управления базами данных с сильной поддержкой
     транзакций, расширяемостью и развитыми механизмами обеспечения целостности.]
    (* <- lang_ru;; *);
    [A free object-relational database management system with strong transaction support,
     extensibility and advanced integrity mechanisms.]
    (* <- lang_en;; *);
=> nrel_software_problem: problem_postgresql_replication_lag;
=> nrel_software_stakeholder: stakeholder_postgresql_global_development_group;
=> nrel_software_requirement: requirement_postgresql_vacuum_efficiency;
=> nrel_software_planning: planning_postgresql_vacuum_release;
=> nrel_software_quality:
    quality_reliability;
    quality_security;
    quality_availability;;

software_git
