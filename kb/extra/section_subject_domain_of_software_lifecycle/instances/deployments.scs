deployment_linux_kernel_6_8
<- concept_software_deployment;
<- concept_wit_entity;
=> nrel_main_idtf:
    [развёртывание ядра Linux 6.8]
    (* <- lang_ru;; *);
    [Linux kernel 6.8 deployment]
    (* <- lang_en;; *);
=> nrel_note:
    [Установка подписанного образа ядра на серверы и рабочие станции целевой
     инфраструктуры с сохранением параметров загрузки и совместимых модулей.]
    (* <- lang_ru;; *);
    [Installation of the signed kernel image onto the servers and workstations of the target
     infrastructure while preserving the boot parameters and compatible modules.]
    (* <- lang_en;; *);
=> nrel_deployment_operation: operation_linux_kernel_6_8;;

deployment_postgresql_16_2_cluster
