maintenance_linux_kernel_6_8_lts
<- concept_software_maintenance;
<- concept_wit_entity;
=> nrel_main_idtf:
    [сопровождение ветки ядра Linux 6.8.y]
    (* <- lang_ru;; *);
    [Linux kernel 6.8.y branch maintenance]
    (* <- lang_en;; *);
=> nrel_note:
    [Исправление выявленных дефектов и перенос исправлений в ветку длительной поддержки,
     в которую переносятся только критичные изменения.]
    (* <- lang_ru;; *);
    [Fixing the detected defects and backporting the fixes into the long-term support branch,
     which receives only critical changes.]
    (* <- lang_en;; *);;

