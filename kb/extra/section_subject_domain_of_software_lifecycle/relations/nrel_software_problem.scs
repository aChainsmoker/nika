nrel_software_problem
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [проблема программного обеспечения*]
    (* <- lang_ru;; *);
    [software problem*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software;
=> nrel_second_domain: concept_software_problem;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software;
            concept_software_problem
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (проблема программного обеспечения*)]
            (* <- lang_ru;; *);
            [Def. (software problem*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Проблема программного обеспечения* - бинарное ориентированное отношение,
                     связывающее программное обеспечение с обнаруженной в нём проблемой,
                     устранение которой требует возобновления работы по жизненному циклу.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Software problem* is a binary oriented relation linking software to a
                     problem detected in it, the elimination of which requires resuming life
                     cycle work.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software;
                concept_software_problem
            };;
    *);;
