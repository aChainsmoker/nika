=> nrel_main_idtf:
    [сборка результата реализации*]
    (* <- lang_ru;; *);
    [building of implementation result*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software_implementation;
=> nrel_second_domain: concept_software_build;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software_implementation;
            concept_software_build
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (сборка результата реализации*)]
            (* <- lang_ru;; *);
            [Def. (building of implementation result*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Сборка результата реализации* - бинарное ориентированное отношение,
