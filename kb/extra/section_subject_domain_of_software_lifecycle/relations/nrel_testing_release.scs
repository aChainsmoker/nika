nrel_testing_release
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [выпуск, подтверждённый тестированием*]
    (* <- lang_ru;; *);
    [release validated by testing*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software_testing;
=> nrel_second_domain: concept_software_release;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software_testing;
            concept_software_release
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (выпуск, подтверждённый тестированием*)]
            (* <- lang_ru;; *);
            [Def. (release validated by testing*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Выпуск, подтверждённый тестированием* - бинарное ориентированное
                     отношение, связывающее тестирование с выпуском принятой по его
                     результатам версии.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Release validated by testing* is a binary oriented relation linking
                     testing to the release of the version accepted on its results.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software_testing;
                concept_software_release
            };;
    *);;
