nrel_software_requirement
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [требование к программному обеспечению*]
    (* <- lang_ru;; *);
    [software requirement*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software;
=> nrel_second_domain: concept_software_requirement;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software;
            concept_software_requirement
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (требование к программному обеспечению*)]
            (* <- lang_ru;; *);
            [Def. (software requirement*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Требование к программному обеспечению* - бинарное ориентированное
                     отношение, связывающее программное обеспечение с предъявляемым к нему
                     требованием, из которого выводится проектное решение.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Software requirement* is a binary oriented relation linking software
                     to a requirement imposed on it, from which a design decision is
                     derived.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software;
                concept_software_requirement
            };;
    *);;
