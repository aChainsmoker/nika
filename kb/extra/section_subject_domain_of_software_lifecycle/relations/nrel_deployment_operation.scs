nrel_deployment_operation
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [эксплуатация развёрнутой версии*]
    (* <- lang_ru;; *);
    [operation of deployed version*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software_deployment;
=> nrel_second_domain: concept_software_operation;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software_deployment;
            concept_software_operation
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (эксплуатация развёрнутой версии*)]
            (* <- lang_ru;; *);
            [Def. (operation of deployed version*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Эксплуатация развёрнутой версии* - бинарное ориентированное отношение,
                     связывающее развёртывание с использованием установленной версии по
                     своему назначению и сопровождением её работы.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Operation of deployed version* is a binary oriented relation linking a
                     deployment to the use of the installed version for its intended purpose
                     and to the monitoring of its work.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software_deployment;
                concept_software_operation
            };;
    *);;
