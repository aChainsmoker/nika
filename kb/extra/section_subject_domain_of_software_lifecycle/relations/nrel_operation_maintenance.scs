nrel_operation_maintenance
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [сопровождение эксплуатируемой версии*]
    (* <- lang_ru;; *);
    [maintenance of operated version*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software_operation;
=> nrel_second_domain: concept_software_maintenance;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software_operation;
            concept_software_maintenance
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (сопровождение эксплуатируемой версии*)]
            (* <- lang_ru;; *);
            [Def. (maintenance of operated version*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Сопровождение эксплуатируемой версии* - бинарное ориентированное
                     отношение, связывающее эксплуатацию с работами по исправлению
                     выявленных в ходе неё проблем и внесению изменений в версию.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Maintenance of operated version* is a binary oriented relation linking
                     operation to the work on fixing the problems identified during it and
                     making changes to the version.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software_operation;
                concept_software_maintenance
            };;
    *);;
