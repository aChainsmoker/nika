nrel_requirements_gathering
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [выявленное при сборе требование*]
    (* <- lang_ru;; *);
    [requirement elicited during gathering*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_requirements_gathering;
=> nrel_second_domain: concept_software_requirement;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_requirements_gathering;
            concept_software_requirement
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (выявленное при сборе требование*)]
            (* <- lang_ru;; *);
            [Def. (requirement elicited during gathering*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Выявленное при сборе требование* - бинарное ориентированное отношение,
                     связывающее сбор требований с требованием, зафиксированным по его
                     результатам и принятым к проектированию.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Requirement elicited during gathering* is a binary oriented relation
                     linking requirements gathering to a requirement recorded as its result
                     and accepted for design.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_requirements_gathering;
                concept_software_requirement
            };;
    *);;
