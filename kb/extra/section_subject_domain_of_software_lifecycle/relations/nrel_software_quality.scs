nrel_software_quality
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [характеристика качества программного обеспечения*]
    (* <- lang_ru;; *);
    [software quality characteristic*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software;
=> nrel_second_domain: concept_software_quality;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software;
            concept_software_quality
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (характеристика качества программного обеспечения*)]
            (* <- lang_ru;; *);
            [Def. (software quality characteristic*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Характеристика качества программного обеспечения* - бинарное
                     ориентированное отношение, связывающее программное обеспечение с
                     оцениваемой для него характеристикой качества, например надёжностью
                     или производительностью.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Software quality characteristic* is a binary oriented relation linking
                     software to a quality characteristic evaluated for it, for example
                     reliability or performance.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software;
                concept_software_quality
            };;
    *);;
