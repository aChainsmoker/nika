nrel_requirement_design
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [проектирование по требованию*]
    (* <- lang_ru;; *);
    [design based on requirement*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software_requirement;
=> nrel_second_domain: concept_software_design;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software_requirement;
            concept_software_design
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (проектирование по требованию*)]
            (* <- lang_ru;; *);
            [Def. (design based on requirement*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Проектирование по требованию* - бинарное ориентированное отношение,
                     связывающее требование с проектным решением, принимаемым для его
                     удовлетворения.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Design based on requirement* is a binary oriented relation linking a
                     requirement to the design decision made to satisfy it.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software_requirement;
                concept_software_design
            };;
    *);;
