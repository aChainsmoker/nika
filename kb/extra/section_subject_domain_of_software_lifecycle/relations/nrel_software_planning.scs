nrel_software_planning
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [планирование программного обеспечения*]
    (* <- lang_ru;; *);
    [software planning*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software;
=> nrel_second_domain: concept_software_planning;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software;
            concept_software_planning
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (планирование программного обеспечения*)]
            (* <- lang_ru;; *);
            [Def. (software planning*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Планирование программного обеспечения* - бинарное ориентированное
                     отношение, связывающее программное обеспечение с выполняемым для него
                     планированием работ, его ресурсами и сроками.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Software planning* is a binary oriented relation linking software to the
                     planning performed for it, with its resources and schedule.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software;
                concept_software_planning
            };;
    *);;
