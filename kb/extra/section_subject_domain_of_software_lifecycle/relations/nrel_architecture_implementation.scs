nrel_architecture_implementation
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [реализация архитектуры*]
    (* <- lang_ru;; *);
    [architecture implementation*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software_architecture;
=> nrel_second_domain: concept_software_implementation;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software_architecture;
            concept_software_implementation
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (реализация архитектуры*)]
            (* <- lang_ru;; *);
            [Def. (architecture implementation*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Реализация архитектуры* - бинарное ориентированное отношение,
                     связывающее архитектуру системы с её реализацией, то есть с
                     разработанным исходным кодом, воплощающим её компоненты.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Architecture implementation* is a binary oriented relation linking the
                     system architecture to its implementation, that is, to the developed
                     source code that embodies its components.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software_architecture;
                concept_software_implementation
            };;
    *);;
