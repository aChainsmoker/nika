nrel_release_deployment
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
    [развёртывание выпущенной версии*]
    (* <- lang_ru;; *);
    [deployment of released version*]
    (* <- lang_en;; *);
=> nrel_first_domain: concept_software_release;
=> nrel_second_domain: concept_software_deployment;
=> nrel_definitional_domain:
    ...
    (*
        <= nrel_combination: {
            concept_software_release;
            concept_software_deployment
        };;
    *);
<- rrel_key_sc_element:
    ...
    (*
        => nrel_main_idtf:
            [Опр. (развёртывание выпущенной версии*)]
            (* <- lang_ru;; *);
            [Def. (deployment of released version*)]
            (* <- lang_en;; *);;
        <- definition;;
        <= nrel_sc_text_translation:
            ...
            (*
                -> rrel_example:
                    [Развёртывание выпущенной версии* - бинарное ориентированное отношение,
                     связывающее выпуск с установкой выпущенной версии на целевую
                     аппаратно-программную платформу.]
                    (* <- lang_ru;; *);;
            *);
            ...
            (*
                -> rrel_example:
                    [Deployment of released version* is a binary oriented relation linking a
                     release to the installation of the released version onto the target
                     hardware and software platform.]
                    (* <- lang_en;; *);;
            *);;
        <= nrel_using_constants:
            {
                concept_software_release;
                concept_software_deployment
            };;
    *);;
